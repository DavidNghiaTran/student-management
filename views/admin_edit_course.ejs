<h2>Sửa môn học</h2>
<form method="post">
  <label>Mã MH</label><input name="ma_mh" value="<%= c.ma_mh %>" required/>
  <label>Tên môn</label><input name="ten_mh" value="<%= c.ten_mh %>" required/>
  <label>Số tín chỉ</label><input type="number" name="so_tin_chi" value="<%= c.so_tin_chi %>"/>
  <button class="btn">Cập nhật</button>
</form>
